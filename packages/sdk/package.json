{
  "name": "@qr-tools/sdk",
  "version": "0.1.0",
  "description": "Customer-facing TypeScript SDK for the QR Tools public API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thangdc/qr-tools.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/thangdc/qr-tools/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pack:check": "npm run build && npm pack --dry-run"
  }
}
